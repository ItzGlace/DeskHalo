<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Version>0.6.1</Version>
    <RootNamespace>DeskHalo_Host</RootNamespace>
    <ApplicationIcon>Assets/deskhalo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" /><PackageReference Include="NAudio.WinMM" Version="2.2.1" /><PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>

    <ItemGroup><Content Include="Assets/deskhalo*" CopyToOutputDirectory="PreserveNewest" /><Content Include="Assets/Fonts/**" CopyToOutputDirectory="PreserveNewest" /><Content Include="Streaming/**" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <Target Name="PublishWinUIResources" AfterTargets="Publish">
    <ItemGroup>
      <DeskHaloXamlResources Include="$(TargetDir)*.xbf;$(TargetDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="WinUI resource index is missing; cannot publish a runnable host." />
    <Copy SourceFiles="@(DeskHaloXamlResources)" DestinationFolder="$(PublishDir)" />
  </Target>
    <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
