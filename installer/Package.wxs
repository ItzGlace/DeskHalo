<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="DeskHalo Host" Manufacturer="ItzGlace" Version="0.6.0" Language="1033"
           UpgradeCode="E10AD584-21E3-489E-A616-10D14FBBDF86" Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer DeskHalo version is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="WINDOWSCURRENTBUILD">
      <RegistrySearch Id="WindowsBuildNumber" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR (VersionNT64 AND WINDOWSCURRENTBUILD &gt;= 19041)" Message="DeskHalo requires Windows 10 version 2004 or newer (64-bit)." />
    <Icon Id="DeskHaloIcon" SourceFile="$(var.PublishDir)\Assets\deskhalo.ico" />
    <Property Id="ARPPRODUCTICON" Value="DeskHaloIcon" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="DeskHalo" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="DeskHaloMenu" Name="DeskHalo">
        <Component Id="StartMenu" Guid="9EF5D042-F17E-4C4C-9589-529A65DF1649">
          <Shortcut Id="StartDeskHalo" Name="DeskHalo Host" Target="[INSTALLFOLDER]DeskHalo Host.exe" WorkingDirectory="INSTALLFOLDER" Icon="DeskHaloIcon" />
          <RemoveFolder Id="RemoveDeskHaloMenu" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\DeskHalo\Installer" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="DeskHalo" Title="DeskHalo Host" Level="1">
      <ComponentGroupRef Id="Payload" />
      <ComponentRef Id="StartMenu" />
    </Feature>
  </Package>
</Wix>
